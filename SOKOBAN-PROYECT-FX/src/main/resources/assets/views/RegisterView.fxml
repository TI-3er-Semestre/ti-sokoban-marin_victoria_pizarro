<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>

<StackPane
    xmlns="http://javafx.com/javafx"
    xmlns:fx="http://javafx.com/fxml"
    fx:controller="control.RegisterController"
    prefWidth="1024" prefHeight="768"
    style="-fx-background-color: #5a7a8a;"
    stylesheets="@../style/game.css">

    <fx:define>
        <ToggleGroup fx:id="avatarGroup"/>
        <ToggleGroup fx:id="difficultyGroup"/>
    </fx:define>

    <!-- Tiles arriba -->
    <HBox maxHeight="64" StackPane.alignment="TOP_LEFT" pickOnBounds="false">
        <Region style="-fx-background-color:#8a9ea8;-fx-border-color:#6a7e88;-fx-border-width:2;" prefWidth="64" prefHeight="64"/>
        <Region style="-fx-background-color:#c0392b;-fx-border-color:#96281b;-fx-border-width:2;" prefWidth="64" prefHeight="64"/>
        <Region style="-fx-background-color:#8a9ea8;-fx-border-color:#6a7e88;-fx-border-width:2;" prefWidth="64" prefHeight="64"/>
        <Region style="-fx-background-color:#c0392b;-fx-border-color:#96281b;-fx-border-width:2;" prefWidth="64" prefHeight="64"/>
        <Region style="-fx-background-color:#8a9ea8;-fx-border-color:#6a7e88;-fx-border-width:2;" prefWidth="64" prefHeight="64"/>
        <Region style="-fx-background-color:#c0392b;-fx-border-color:#96281b;-fx-border-width:2;" prefWidth="64" prefHeight="64"/>
        <Region style="-fx-background-color:#8a9ea8;-fx-border-color:#6a7e88;-fx-border-width:2;" prefWidth="64" prefHeight="64"/>
        <Region style="-fx-background-color:#c0392b;-fx-border-color:#96281b;-fx-border-width:2;" prefWidth="64" prefHeight="64"/>
        <Region style="-fx-background-color:#8a9ea8;-fx-border-color:#6a7e88;-fx-border-width:2;" prefWidth="64" prefHeight="64"/>
        <Region style="-fx-background-color:#c0392b;-fx-border-color:#96281b;-fx-border-width:2;" prefWidth="64" prefHeight="64"/>
        <Region style="-fx-background-color:#8a9ea8;-fx-border-color:#6a7e88;-fx-border-width:2;" prefWidth="64" prefHeight="64"/>
        <Region style="-fx-background-color:#c0392b;-fx-border-color:#96281b;-fx-border-width:2;" prefWidth="64" prefHeight="64"/>
        <Region style="-fx-background-color:#8a9ea8;-fx-border-color:#6a7e88;-fx-border-width:2;" prefWidth="64" prefHeight="64"/>
        <Region style="-fx-background-color:#c0392b;-fx-border-color:#96281b;-fx-border-width:2;" prefWidth="64" prefHeight="64"/>
        <Region style="-fx-background-color:#8a9ea8;-fx-border-color:#6a7e88;-fx-border-width:2;" prefWidth="64" prefHeight="64"/>
        <Region style="-fx-background-color:#c0392b;-fx-border-color:#96281b;-fx-border-width:2;" prefWidth="64" prefHeight="64"/>
    </HBox>

    <!-- Tiles abajo -->
    <HBox maxHeight="64" StackPane.alignment="BOTTOM_LEFT" pickOnBounds="false">
        <Region style="-fx-background-color:#c0392b;-fx-border-color:#96281b;-fx-border-width:2;" prefWidth="64" prefHeight="64"/>
        <Region style="-fx-background-color:#8a9ea8;-fx-border-color:#6a7e88;-fx-border-width:2;" prefWidth="64" prefHeight="64"/>
        <Region style="-fx-background-color:#c0392b;-fx-border-color:#96281b;-fx-border-width:2;" prefWidth="64" prefHeight="64"/>
        <Region style="-fx-background-color:#8a9ea8;-fx-border-color:#6a7e88;-fx-border-width:2;" prefWidth="64" prefHeight="64"/>
        <Region style="-fx-background-color:#c0392b;-fx-border-color:#96281b;-fx-border-width:2;" prefWidth="64" prefHeight="64"/>
        <Region style="-fx-background-color:#8a9ea8;-fx-border-color:#6a7e88;-fx-border-width:2;" prefWidth="64" prefHeight="64"/>
        <Region style="-fx-background-color:#c0392b;-fx-border-color:#96281b;-fx-border-width:2;" prefWidth="64" prefHeight="64"/>
        <Region style="-fx-background-color:#8a9ea8;-fx-border-color:#6a7e88;-fx-border-width:2;" prefWidth="64" prefHeight="64"/>
        <Region style="-fx-background-color:#c0392b;-fx-border-color:#96281b;-fx-border-width:2;" prefWidth="64" prefHeight="64"/>
        <Region style="-fx-background-color:#8a9ea8;-fx-border-color:#6a7e88;-fx-border-width:2;" prefWidth="64" prefHeight="64"/>
        <Region style="-fx-background-color:#c0392b;-fx-border-color:#96281b;-fx-border-width:2;" prefWidth="64" prefHeight="64"/>
        <Region style="-fx-background-color:#8a9ea8;-fx-border-color:#6a7e88;-fx-border-width:2;" prefWidth="64" prefHeight="64"/>
        <Region style="-fx-background-color:#c0392b;-fx-border-color:#96281b;-fx-border-width:2;" prefWidth="64" prefHeight="64"/>
        <Region style="-fx-background-color:#8a9ea8;-fx-border-color:#6a7e88;-fx-border-width:2;" prefWidth="64" prefHeight="64"/>
        <Region style="-fx-background-color:#c0392b;-fx-border-color:#96281b;-fx-border-width:2;" prefWidth="64" prefHeight="64"/>
        <Region style="-fx-background-color:#8a9ea8;-fx-border-color:#6a7e88;-fx-border-width:2;" prefWidth="64" prefHeight="64"/>
    </HBox>

    <!-- Contenido principal -->
    <VBox alignment="CENTER" pickOnBounds="false" style="-fx-padding: 70 0 70 0;">
        <HBox alignment="CENTER" spacing="24">

            <!-- IZQUIERDA: formulario -->
            <VBox spacing="9" prefWidth="360"
                  style="-fx-background-color: #2c2c2c;
                         -fx-border-color: #111111; -fx-border-width: 3;
                         -fx-border-radius: 10; -fx-background-radius: 10;
                         -fx-effect: dropshadow(gaussian,#111111,0,0,0,6);
                         -fx-padding: 18;">

                <Label text="[ NUEVO JUGADOR ]" maxWidth="Infinity" alignment="CENTER"
                       style="-fx-text-fill: #f0e060; -fx-font-size: 15px;
                              -fx-font-weight: bold; -fx-font-family: 'Courier New';"/>

                <!-- Nombre -->
                <VBox spacing="3">
                    <Label text="NOMBRE COMPLETO"
                           style="-fx-text-fill: #aaaaaa; -fx-font-size: 10px; -fx-font-family: 'Courier New';"/>
                    <TextField fx:id="nameField" promptText="Ingresa tu nombre completo"
                               maxWidth="Infinity"
                               style="-fx-background-color: #1a1a1a; -fx-border-color: #444444;
                                      -fx-border-width: 2; -fx-border-radius: 5; -fx-background-radius: 5;
                                      -fx-text-fill: #e0e0e0; -fx-font-size: 12px;
                                      -fx-font-family: 'Courier New'; -fx-prompt-text-fill: #555555;
                                      -fx-padding: 5 10 5 10;"/>
                </VBox>

                <!-- Email -->
                <VBox spacing="3">
                    <Label text="CORREO ELECTRONICO"
                           style="-fx-text-fill: #aaaaaa; -fx-font-size: 10px; -fx-font-family: 'Courier New';"/>
                    <TextField fx:id="emailField" promptText="correo@icesi.edu.co"
                               maxWidth="Infinity"
                               style="-fx-background-color: #1a1a1a; -fx-border-color: #444444;
                                      -fx-border-width: 2; -fx-border-radius: 5; -fx-background-radius: 5;
                                      -fx-text-fill: #e0e0e0; -fx-font-size: 12px;
                                      -fx-font-family: 'Courier New'; -fx-prompt-text-fill: #555555;
                                      -fx-padding: 5 10 5 10;"/>
                </VBox>

                <!-- Username -->
                <VBox spacing="3">
                    <Label text="USERNAME"
                           style="-fx-text-fill: #aaaaaa; -fx-font-size: 10px; -fx-font-family: 'Courier New';"/>
                    <TextField fx:id="usernameField" promptText="Tu nombre de usuario"
                               maxWidth="Infinity"
                               style="-fx-background-color: #1a1a1a; -fx-border-color: #444444;
                                      -fx-border-width: 2; -fx-border-radius: 5; -fx-background-radius: 5;
                                      -fx-text-fill: #e0e0e0; -fx-font-size: 12px;
                                      -fx-font-family: 'Courier New'; -fx-prompt-text-fill: #555555;
                                      -fx-padding: 5 10 5 10;"/>
                </VBox>

                <!-- Avatar — sin style inline para que el controller pueda cambiar el borde -->
                <VBox spacing="5">
                    <Label text="AVATAR"
                           style="-fx-text-fill: #aaaaaa; -fx-font-size: 10px; -fx-font-family: 'Courier New';"/>
                    <HBox spacing="6">
                        <ToggleButton fx:id="avatar1"
                                      toggleGroup="$avatarGroup"
                                      selected="true" userData="player_05.png">
                            <graphic>
                                <ImageView fitWidth="44" fitHeight="44"
                                           preserveRatio="true" smooth="true">
                                    <image><Image url="@../sprites/player_05.png"/></image>
                                </ImageView>
                            </graphic>
                        </ToggleButton>
                        <ToggleButton fx:id="avatar2"
                                      toggleGroup="$avatarGroup"
                                      userData="player_06.png">
                            <graphic>
                                <ImageView fitWidth="44" fitHeight="44"
                                           preserveRatio="true" smooth="true">
                                    <image><Image url="@../sprites/player_06.png"/></image>
                                </ImageView>
                            </graphic>
                        </ToggleButton>
                        <ToggleButton fx:id="avatar3"
                                      toggleGroup="$avatarGroup"
                                      userData="player_07.png">
                            <graphic>
                                <ImageView fitWidth="44" fitHeight="44"
                                           preserveRatio="true" smooth="true">
                                    <image><Image url="@../sprites/player_07.png"/></image>
                                </ImageView>
                            </graphic>
                        </ToggleButton>
                        <ToggleButton fx:id="avatar4"
                                      toggleGroup="$avatarGroup"
                                      userData="player_08.png">
                            <graphic>
                                <ImageView fitWidth="44" fitHeight="44"
                                           preserveRatio="true" smooth="true">
                                    <image><Image url="@../sprites/player_08.png"/></image>
                                </ImageView>
                            </graphic>
                        </ToggleButton>
                    </HBox>
                </VBox>

                <!-- Dificultad — sin style inline -->
                <VBox spacing="5">
                    <Label text="NIVEL DE EXPERIENCIA"
                           style="-fx-text-fill: #aaaaaa; -fx-font-size: 10px; -fx-font-family: 'Courier New';"/>
                    <HBox spacing="6">
                        <ToggleButton fx:id="diffBeginner" text="PRINCIPIANTE"
                                      toggleGroup="$difficultyGroup" selected="true" userData="BEGINNER"
                                      HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        <ToggleButton fx:id="diffAdvanced" text="AVANZADO"
                                      toggleGroup="$difficultyGroup" userData="ADVANCED"
                                      HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        <ToggleButton fx:id="diffExpert" text="EXPERTO"
                                      toggleGroup="$difficultyGroup" userData="EXPERT"
                                      HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    </HBox>
                </VBox>

                <!-- Error -->
                <Label fx:id="errorLabel" text="" wrapText="true" maxWidth="Infinity"
                       style="-fx-text-fill: #e74c3c; -fx-font-size: 10px; -fx-font-family: 'Courier New';"/>

                <!-- Submit — con onAction -->
                <Button fx:id="submitButton" text="▶  COMENZAR" maxWidth="Infinity"
                        onAction="#handleSubmit"
                        style="-fx-background-color: #27ae60; -fx-border-color: #1e8449;
                               -fx-border-width: 3; -fx-border-radius: 7; -fx-background-radius: 7;
                               -fx-effect: dropshadow(gaussian,#145a30,0,0,0,3);
                               -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold;
                               -fx-font-family: 'Courier New'; -fx-pref-height: 38px; -fx-cursor: hand;"/>
            </VBox>

            <!-- DERECHA: preview -->
            <VBox alignment="CENTER" spacing="10" prefWidth="200">
                <Label text="PREVIEW"
                       style="-fx-text-fill: #aaaaaa; -fx-font-size: 10px;
                              -fx-font-family: 'Courier New'; -fx-font-weight: bold;"/>
                <StackPane style="-fx-background-color: #1a1a1a;
                                  -fx-border-color: #f0e060; -fx-border-width: 3;
                                  -fx-border-radius: 12; -fx-background-radius: 12;
                                  -fx-padding: 14;">
                    <VBox alignment="CENTER" spacing="8">
                        <StackPane>
                            <Region prefWidth="96" prefHeight="96"
                                    style="-fx-background-color: #8a9ea8;
                                           -fx-border-color: #6a7e88; -fx-border-width: 2;
                                           -fx-border-radius: 4; -fx-background-radius: 4;"/>
                            <ImageView fx:id="avatarPreview"
                                       fitWidth="80" fitHeight="80"
                                       preserveRatio="true" smooth="true">
                                <image><Image url="@../sprites/player_05.png"/></image>
                            </ImageView>
                        </StackPane>
                        <Label fx:id="avatarNameLabel" text="JUGADOR 1"
                               style="-fx-text-fill: #f0e060; -fx-font-size: 11px;
                                      -fx-font-weight: bold; -fx-font-family: 'Courier New';"/>
                    </VBox>
                </StackPane>
                <Label text="Elige tu personaje"
                       style="-fx-text-fill: #666666; -fx-font-size: 10px;
                              -fx-font-family: 'Courier New';"/>
            </VBox>

        </HBox>
    </VBox>

</StackPane>
