<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane
    xmlns="http://javafx.com/javafx"
    xmlns:fx="http://javafx.com/fxml"
    prefWidth="1024" prefHeight="768"
    stylesheets="@../style/game.css"
    style="-fx-background-color: #1a1a1a;">

    <fx:define>
        <ToggleGroup fx:id="sectionGroup"/>
    </fx:define>

    <!-- ══ SIDEBAR ══ -->
    <left>
        <VBox style="-fx-background-color: #111111;
                     -fx-border-color: #333333;
                     -fx-border-width: 0 2 0 0;
                     -fx-min-width: 150px;
                     -fx-pref-width: 150px;">

            <!-- Logo -->
            <VBox alignment="CENTER" style="-fx-padding: 14 10 10 10;">
                <StackPane style="-fx-background-color: #c0392b;
                                  -fx-border-color: #96281b;
                                  -fx-border-width: 2;
                                  -fx-border-radius: 6;
                                  -fx-background-radius: 6;
                                  -fx-padding: 6 16 6 16;">
                    <Label text="SOKOBAN"
                           style="-fx-text-fill: white;
                                  -fx-font-size: 13px;
                                  -fx-font-weight: bold;
                                  -fx-font-family: 'Courier New';"/>
                </StackPane>
            </VBox>

            <Separator/>

            <!-- Nav buttons -->
            <ToggleButton fx:id="btnWhatIs"
                          text="▶  Que es?"
                          toggleGroup="$sectionGroup"
                          selected="true"
                          maxWidth="Infinity"
                          style="-fx-background-color: rgba(240,224,96,0.06);
                                 -fx-border-color: #f0e060 transparent #f0e060 #f0e060;
                                 -fx-text-fill: #f0e060;
                                 -fx-font-family: 'Courier New';
                                 -fx-font-size: 11px;
                                 -fx-font-weight: bold;
                                 -fx-alignment: center-left;
                                 -fx-padding: 10 0 10 14;
                                 -fx-pref-height: 40px;"/>

            <ToggleButton fx:id="btnElements"
                          text="◈  Elementos"
                          toggleGroup="$sectionGroup"
                          maxWidth="Infinity"
                          style="-fx-background-color: transparent;
                                 -fx-border-color: transparent;
                                 -fx-text-fill: #666666;
                                 -fx-font-family: 'Courier New';
                                 -fx-font-size: 11px;
                                 -fx-font-weight: bold;
                                 -fx-alignment: center-left;
                                 -fx-padding: 10 0 10 14;
                                 -fx-pref-height: 40px;"/>

            <ToggleButton fx:id="btnControls"
                          text="⌨  Controles"
                          toggleGroup="$sectionGroup"
                          maxWidth="Infinity"
                          style="-fx-background-color: transparent;
                                 -fx-border-color: transparent;
                                 -fx-text-fill: #666666;
                                 -fx-font-family: 'Courier New';
                                 -fx-font-size: 11px;
                                 -fx-font-weight: bold;
                                 -fx-alignment: center-left;
                                 -fx-padding: 10 0 10 14;
                                 -fx-pref-height: 40px;"/>

            <ToggleButton fx:id="btnIndicators"
                          text="◉  Indicadores"
                          toggleGroup="$sectionGroup"
                          maxWidth="Infinity"
                          style="-fx-background-color: transparent;
                                 -fx-border-color: transparent;
                                 -fx-text-fill: #666666;
                                 -fx-font-family: 'Courier New';
                                 -fx-font-size: 11px;
                                 -fx-font-weight: bold;
                                 -fx-alignment: center-left;
                                 -fx-padding: 10 0 10 14;
                                 -fx-pref-height: 40px;"/>

            <ToggleButton fx:id="btnLevels"
                          text="★  Niveles"
                          toggleGroup="$sectionGroup"
                          maxWidth="Infinity"
                          style="-fx-background-color: transparent;
                                 -fx-border-color: transparent;
                                 -fx-text-fill: #666666;
                                 -fx-font-family: 'Courier New';
                                 -fx-font-size: 11px;
                                 -fx-font-weight: bold;
                                 -fx-alignment: center-left;
                                 -fx-padding: 10 0 10 14;
                                 -fx-pref-height: 40px;"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Button text="↩ VOLVER"
                    maxWidth="Infinity"
                    style="-fx-background-color: #333333;
                           -fx-border-color: #555555;
                           -fx-border-width: 2;
                           -fx-border-radius: 6;
                           -fx-background-radius: 6;
                           -fx-text-fill: #cccccc;
                           -fx-font-family: 'Courier New';
                           -fx-font-size: 12px;
                           -fx-cursor: hand;">
                <VBox.margin><Insets top="10" right="10" bottom="10" left="10"/></VBox.margin>
            </Button>
        </VBox>
    </left>

    <!-- ══ CONTENIDO ══ -->
    <center>
        <ScrollPane fitToWidth="true"
                    style="-fx-background: #1a1a1a;
                           -fx-background-color: #1a1a1a;
                           -fx-border-color: transparent;">

            <!-- El controller muestra/oculta cada VBox según el botón activo -->
            <VBox fx:id="contentArea"
                  style="-fx-background-color: #1a1a1a; -fx-padding: 20;"
                  spacing="18">

                <!-- SECCION: Que es -->
                <VBox fx:id="sectionWhatIs" spacing="12">

                    <Label text="[ QUE ES SOKOBAN? ]"
                           style="-fx-text-fill: #f0e060;
                                  -fx-font-size: 14px;
                                  -fx-font-weight: bold;
                                  -fx-font-family: 'Courier New';"
                           maxWidth="Infinity"/>

                    <Label wrapText="true"
                           style="-fx-text-fill: #aaaaaa; -fx-font-size: 12px; -fx-font-family: 'Courier New';"
                           text="Sokoban es un juego de logica y puzzles. Tu objetivo es empujar todas las cajas hasta las posiciones objetivo usando el movimiento de tu personaje."/>

                    <Label wrapText="true"
                           style="-fx-text-fill: #aaaaaa; -fx-font-size: 12px; -fx-font-family: 'Courier New';"
                           text="El juego pone a prueba tu capacidad de planificar con anticipacion. Un movimiento incorrecto puede bloquear una caja, obligandote a reiniciar."/>

                    <VBox style="-fx-background-color: #111111;
                                 -fx-border-color: #333333;
                                 -fx-border-width: 2;
                                 -fx-border-radius: 7;
                                 -fx-background-radius: 7;
                                 -fx-padding: 12;"
                          spacing="6">
                        <Label style="-fx-text-fill: #cccccc; -fx-font-size: 12px; -fx-font-weight: bold; -fx-font-family: 'Courier New';"
                               text="Reglas basicas:"/>
                        <Label wrapText="true"
                               style="-fx-text-fill: #aaaaaa; -fx-font-size: 12px; -fx-font-family: 'Courier New';"
                               text="• Solo puedes EMPUJAR cajas, nunca jalarlas."/>
                        <Label wrapText="true"
                               style="-fx-text-fill: #aaaaaa; -fx-font-size: 12px; -fx-font-family: 'Courier New';"
                               text="• No puedes empujar una caja si hay otra caja o un muro detras."/>
                        <Label wrapText="true"
                               style="-fx-text-fill: #aaaaaa; -fx-font-size: 12px; -fx-font-family: 'Courier New';"
                               text="• El nivel termina cuando TODAS las cajas esten sobre los objetivos."/>
                        <Label wrapText="true"
                               style="-fx-text-fill: #aaaaaa; -fx-font-size: 12px; -fx-font-family: 'Courier New';"
                               text="• Usa UNDO para deshacer movimientos si te equivocas."/>
                    </VBox>
                </VBox>

                <!-- SECCION: Elementos (oculta por defecto) -->
                <VBox fx:id="sectionElements" spacing="10"
                      managed="false" visible="false">

                    <Label text="[ ELEMENTOS DEL TABLERO ]"
                           style="-fx-text-fill: #f0e060; -fx-font-size: 14px;
                                  -fx-font-weight: bold; -fx-font-family: 'Courier New';"
                           maxWidth="Infinity"/>

                    <!-- Muro -->
                    <HBox spacing="12" alignment="CENTER_LEFT"
                          style="-fx-background-color: #222222; -fx-border-color: #333333;
                                 -fx-border-width: 1; -fx-border-radius: 6;
                                 -fx-background-radius: 6; -fx-padding: 10;">
                        <Region prefWidth="36" prefHeight="36"
                                style="-fx-background-color: #c0392b;
                                       -fx-border-color: #96281b; -fx-border-width: 2;
                                       -fx-border-radius: 4; -fx-background-radius: 4;"/>
                        <VBox spacing="2">
                            <Label style="-fx-text-fill: #e0e0e0; -fx-font-weight: bold; -fx-font-family: 'Courier New'; -fx-font-size:12px;" text="Muro"/>
                            <Label style="-fx-text-fill: #888888; -fx-font-family: 'Courier New'; -fx-font-size:11px;" text="Obstaculo. No se puede atravesar."/>
                        </VBox>
                    </HBox>

                    <!-- Piso -->
                    <HBox spacing="12" alignment="CENTER_LEFT"
                          style="-fx-background-color: #222222; -fx-border-color: #333333;
                                 -fx-border-width: 1; -fx-border-radius: 6;
                                 -fx-background-radius: 6; -fx-padding: 10;">
                        <Region prefWidth="36" prefHeight="36"
                                style="-fx-background-color: #8a9ea8;
                                       -fx-border-color: #6a7e88; -fx-border-width: 2;
                                       -fx-border-radius: 4; -fx-background-radius: 4;"/>
                        <VBox spacing="2">
                            <Label style="-fx-text-fill: #e0e0e0; -fx-font-weight: bold; -fx-font-family: 'Courier New'; -fx-font-size:12px;" text="Piso"/>
                            <Label style="-fx-text-fill: #888888; -fx-font-family: 'Courier New'; -fx-font-size:11px;" text="Celda transitable libre."/>
                        </VBox>
                    </HBox>

                    <!-- Caja -->
                    <HBox spacing="12" alignment="CENTER_LEFT"
                          style="-fx-background-color: #222222; -fx-border-color: #333333;
                                 -fx-border-width: 1; -fx-border-radius: 6;
                                 -fx-background-radius: 6; -fx-padding: 10;">
                        <Region prefWidth="36" prefHeight="36"
                                style="-fx-background-color: #c8862a;
                                       -fx-border-color: #a06020; -fx-border-width: 2;
                                       -fx-border-radius: 4; -fx-background-radius: 4;"/>
                        <VBox spacing="2">
                            <Label style="-fx-text-fill: #e0e0e0; -fx-font-weight: bold; -fx-font-family: 'Courier New'; -fx-font-size:12px;" text="Caja"/>
                            <Label style="-fx-text-fill: #888888; -fx-font-family: 'Courier New'; -fx-font-size:11px;" text="Empujala hasta el objetivo."/>
                        </VBox>
                    </HBox>

                    <!-- Objetivo -->
                    <HBox spacing="12" alignment="CENTER_LEFT"
                          style="-fx-background-color: #222222; -fx-border-color: #333333;
                                 -fx-border-width: 1; -fx-border-radius: 6;
                                 -fx-background-radius: 6; -fx-padding: 10;">
                        <Region prefWidth="36" prefHeight="36"
                                style="-fx-background-color: #8a9ea8;
                                       -fx-border-color: #e67e22; -fx-border-width: 3;
                                       -fx-border-radius: 4; -fx-background-radius: 4;"/>
                        <VBox spacing="2">
                            <Label style="-fx-text-fill: #e0e0e0; -fx-font-weight: bold; -fx-font-family: 'Courier New'; -fx-font-size:12px;" text="Objetivo"/>
                            <Label style="-fx-text-fill: #888888; -fx-font-family: 'Courier New'; -fx-font-size:11px;" text="Posicion destino de la caja."/>
                        </VBox>
                    </HBox>

                    <!-- Caja en objetivo -->
                    <HBox spacing="12" alignment="CENTER_LEFT"
                          style="-fx-background-color: #222222; -fx-border-color: #333333;
                                 -fx-border-width: 1; -fx-border-radius: 6;
                                 -fx-background-radius: 6; -fx-padding: 10;">
                        <Region prefWidth="36" prefHeight="36"
                                style="-fx-background-color: #2ecc71;
                                       -fx-border-color: #1a9e55; -fx-border-width: 2;
                                       -fx-border-radius: 4; -fx-background-radius: 4;"/>
                        <VBox spacing="2">
                            <Label style="-fx-text-fill: #e0e0e0; -fx-font-weight: bold; -fx-font-family: 'Courier New'; -fx-font-size:12px;" text="Caja en objetivo"/>
                            <Label style="-fx-text-fill: #888888; -fx-font-family: 'Courier New'; -fx-font-size:11px;" text="Caja correctamente colocada."/>
                        </VBox>
                    </HBox>
                </VBox>

                <!-- SECCION: Controles (oculta) -->
                <VBox fx:id="sectionControls" spacing="12"
                      managed="false" visible="false">

                    <Label text="[ CONTROLES ]"
                           style="-fx-text-fill: #f0e060; -fx-font-size: 14px;
                                  -fx-font-weight: bold; -fx-font-family: 'Courier New';"
                           maxWidth="Infinity"/>

                    <Label style="-fx-text-fill: #888888; -fx-font-size: 9px; -fx-font-family: 'Courier New'; -fx-font-weight: bold;"
                           text="MOVIMIENTO"/>

                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="W / ↑"
                               style="-fx-background-color: #2c2c2c; -fx-border-color: #555555;
                                      -fx-border-width: 2; -fx-border-radius: 5; -fx-background-radius: 5;
                                      -fx-text-fill: #e0e0e0; -fx-font-family: 'Courier New';
                                      -fx-font-size: 11px; -fx-font-weight: bold;
                                      -fx-min-width: 64px; -fx-pref-height: 30px;
                                      -fx-alignment: center; -fx-padding: 0 8 0 8;"/>
                        <Label text="Mover arriba"
                               style="-fx-text-fill: #aaaaaa; -fx-font-size: 12px; -fx-font-family: 'Courier New';"/>
                    </HBox>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="S / ↓"
                               style="-fx-background-color: #2c2c2c; -fx-border-color: #555555;
                                      -fx-border-width: 2; -fx-border-radius: 5; -fx-background-radius: 5;
                                      -fx-text-fill: #e0e0e0; -fx-font-family: 'Courier New';
                                      -fx-font-size: 11px; -fx-font-weight: bold;
                                      -fx-min-width: 64px; -fx-pref-height: 30px;
                                      -fx-alignment: center; -fx-padding: 0 8 0 8;"/>
                        <Label text="Mover abajo"
                               style="-fx-text-fill: #aaaaaa; -fx-font-size: 12px; -fx-font-family: 'Courier New';"/>
                    </HBox>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="A / ←"
                               style="-fx-background-color: #2c2c2c; -fx-border-color: #555555;
                                      -fx-border-width: 2; -fx-border-radius: 5; -fx-background-radius: 5;
                                      -fx-text-fill: #e0e0e0; -fx-font-family: 'Courier New';
                                      -fx-font-size: 11px; -fx-font-weight: bold;
                                      -fx-min-width: 64px; -fx-pref-height: 30px;
                                      -fx-alignment: center; -fx-padding: 0 8 0 8;"/>
                        <Label text="Mover izquierda"
                               style="-fx-text-fill: #aaaaaa; -fx-font-size: 12px; -fx-font-family: 'Courier New';"/>
                    </HBox>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="D / →"
                               style="-fx-background-color: #2c2c2c; -fx-border-color: #555555;
                                      -fx-border-width: 2; -fx-border-radius: 5; -fx-background-radius: 5;
                                      -fx-text-fill: #e0e0e0; -fx-font-family: 'Courier New';
                                      -fx-font-size: 11px; -fx-font-weight: bold;
                                      -fx-min-width: 64px; -fx-pref-height: 30px;
                                      -fx-alignment: center; -fx-padding: 0 8 0 8;"/>
                        <Label text="Mover derecha"
                               style="-fx-text-fill: #aaaaaa; -fx-font-size: 12px; -fx-font-family: 'Courier New';"/>
                    </HBox>

                    <Label style="-fx-text-fill: #888888; -fx-font-size: 9px; -fx-font-family: 'Courier New'; -fx-font-weight: bold;"
                           text="ACCIONES"/>

                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="CTRL+Z"
                               style="-fx-background-color: #2c2c2c; -fx-border-color: #555555;
                                      -fx-border-width: 2; -fx-border-radius: 5; -fx-background-radius: 5;
                                      -fx-text-fill: #e0e0e0; -fx-font-family: 'Courier New';
                                      -fx-font-size: 11px; -fx-font-weight: bold;
                                      -fx-min-width: 64px; -fx-pref-height: 30px;
                                      -fx-alignment: center; -fx-padding: 0 8 0 8;"/>
                        <Label text="Deshacer ultimo movimiento (UNDO)"
                               style="-fx-text-fill: #aaaaaa; -fx-font-size: 12px; -fx-font-family: 'Courier New';"/>
                    </HBox>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="R"
                               style="-fx-background-color: #2c2c2c; -fx-border-color: #555555;
                                      -fx-border-width: 2; -fx-border-radius: 5; -fx-background-radius: 5;
                                      -fx-text-fill: #e0e0e0; -fx-font-family: 'Courier New';
                                      -fx-font-size: 11px; -fx-font-weight: bold;
                                      -fx-min-width: 64px; -fx-pref-height: 30px;
                                      -fx-alignment: center; -fx-padding: 0 8 0 8;"/>
                        <Label text="Reiniciar nivel desde cero"
                               style="-fx-text-fill: #aaaaaa; -fx-font-size: 12px; -fx-font-family: 'Courier New';"/>
                    </HBox>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="ESC"
                               style="-fx-background-color: #2c2c2c; -fx-border-color: #555555;
                                      -fx-border-width: 2; -fx-border-radius: 5; -fx-background-radius: 5;
                                      -fx-text-fill: #e0e0e0; -fx-font-family: 'Courier New';
                                      -fx-font-size: 11px; -fx-font-weight: bold;
                                      -fx-min-width: 64px; -fx-pref-height: 30px;
                                      -fx-alignment: center; -fx-padding: 0 8 0 8;"/>
                        <Label text="Pausar / Volver al menu"
                               style="-fx-text-fill: #aaaaaa; -fx-font-size: 12px; -fx-font-family: 'Courier New';"/>
                    </HBox>
                </VBox>

                <!-- SECCION: Indicadores (oculta) -->
                <VBox fx:id="sectionIndicators" spacing="12"
                      managed="false" visible="false">

                    <Label text="[ INDICADORES HUD ]"
                           style="-fx-text-fill: #f0e060; -fx-font-size: 14px;
                                  -fx-font-weight: bold; -fx-font-family: 'Courier New';"
                           maxWidth="Infinity"/>

                    <Label wrapText="true"
                           style="-fx-text-fill: #aaaaaa; -fx-font-size: 12px; -fx-font-family: 'Courier New';"
                           text="Durante el juego veras una barra en la parte superior con 4 indicadores:"/>

                    <HBox spacing="10">
                        <VBox style="-fx-background-color: #111111; -fx-border-color: #333333;
                                     -fx-border-width: 2; -fx-border-radius: 7; -fx-background-radius: 7;
                                     -fx-padding: 10 12 10 12;" spacing="4" HBox.hgrow="ALWAYS">
                            <Label style="-fx-text-fill: #f0e060; -fx-font-size: 20px; -fx-font-weight: bold; -fx-font-family: 'Courier New';" text="014"/>
                            <Label style="-fx-text-fill: #c8862a; -fx-font-size: 10px; -fx-font-weight: bold; -fx-font-family: 'Courier New';" text="MOVIMIENTOS"/>
                            <Label wrapText="true"
                                   style="-fx-text-fill: #666666; -fx-font-size: 10px; -fx-font-family: 'Courier New';"
                                   text="Pasos totales dados. Menos = mejor ranking."/>
                        </VBox>
                        <VBox style="-fx-background-color: #111111; -fx-border-color: #333333;
                                     -fx-border-width: 2; -fx-border-radius: 7; -fx-background-radius: 7;
                                     -fx-padding: 10 12 10 12;" spacing="4" HBox.hgrow="ALWAYS">
                            <Label style="-fx-text-fill: #f0e060; -fx-font-size: 20px; -fx-font-weight: bold; -fx-font-family: 'Courier New';" text="006"/>
                            <Label style="-fx-text-fill: #c8862a; -fx-font-size: 10px; -fx-font-weight: bold; -fx-font-family: 'Courier New';" text="EMPUJES"/>
                            <Label wrapText="true"
                                   style="-fx-text-fill: #666666; -fx-font-size: 10px; -fx-font-family: 'Courier New';"
                                   text="Veces que empujaste una caja."/>
                        </VBox>
                    </HBox>
                    <HBox spacing="10">
                        <VBox style="-fx-background-color: #111111; -fx-border-color: #333333;
                                     -fx-border-width: 2; -fx-border-radius: 7; -fx-background-radius: 7;
                                     -fx-padding: 10 12 10 12;" spacing="4" HBox.hgrow="ALWAYS">
                            <Label style="-fx-text-fill: #f0e060; -fx-font-size: 20px; -fx-font-weight: bold; -fx-font-family: 'Courier New';" text="01:23"/>
                            <Label style="-fx-text-fill: #c8862a; -fx-font-size: 10px; -fx-font-weight: bold; -fx-font-family: 'Courier New';" text="TIEMPO"/>
                            <Label wrapText="true"
                                   style="-fx-text-fill: #666666; -fx-font-size: 10px; -fx-font-family: 'Courier New';"
                                   text="Tiempo transcurrido. Formato MM:SS."/>
                        </VBox>
                        <VBox style="-fx-background-color: #111111; -fx-border-color: #333333;
                                     -fx-border-width: 2; -fx-border-radius: 7; -fx-background-radius: 7;
                                     -fx-padding: 10 12 10 12;" spacing="4" HBox.hgrow="ALWAYS">
                            <Label style="-fx-text-fill: #f0e060; -fx-font-size: 20px; -fx-font-weight: bold; -fx-font-family: 'Courier New';" text="02"/>
                            <Label style="-fx-text-fill: #c8862a; -fx-font-size: 10px; -fx-font-weight: bold; -fx-font-family: 'Courier New';" text="NIVEL"/>
                            <Label wrapText="true"
                                   style="-fx-text-fill: #666666; -fx-font-size: 10px; -fx-font-family: 'Courier New';"
                                   text="Escenario actual. Hay 3 niveles."/>
                        </VBox>
                    </HBox>
                </VBox>

                <!-- SECCION: Niveles (oculta) -->
                <VBox fx:id="sectionLevels" spacing="12"
                      managed="false" visible="false">

                    <Label text="[ NIVELES ]"
                           style="-fx-text-fill: #f0e060; -fx-font-size: 14px;
                                  -fx-font-weight: bold; -fx-font-family: 'Courier New';"
                           maxWidth="Infinity"/>

                    <HBox style="-fx-background-color: #111111; -fx-border-color: #333333;
                                  -fx-border-width: 2; -fx-border-radius: 7; -fx-background-radius: 7;
                                  -fx-padding: 12 14 12 14;"
                          spacing="14" alignment="CENTER_LEFT">
                        <Label text="NVL 1"
                               style="-fx-background-color: #c8862a; -fx-border-color: #a06020;
                                      -fx-border-width: 2; -fx-border-radius: 5; -fx-background-radius: 5;
                                      -fx-text-fill: white; -fx-font-family: 'Courier New';
                                      -fx-font-size: 11px; -fx-font-weight: bold;
                                      -fx-padding: 4 10 4 10;"/>
                        <VBox spacing="4">
                            <Label style="-fx-text-fill: #e0e0e0; -fx-font-weight: bold; -fx-font-family: 'Courier New'; -fx-font-size:12px;" text="Basico"/>
                            <Label wrapText="true"
                                   style="-fx-text-fill: #888888; -fx-font-family: 'Courier New'; -fx-font-size:11px;"
                                   text="1 caja, 1 objetivo. Sin obstaculos. Ideal para aprender."/>
                        </VBox>
                    </HBox>

                    <HBox style="-fx-background-color: #111111; -fx-border-color: #333333;
                                  -fx-border-width: 2; -fx-border-radius: 7; -fx-background-radius: 7;
                                  -fx-padding: 12 14 12 14;"
                          spacing="14" alignment="CENTER_LEFT">
